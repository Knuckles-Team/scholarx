# ScholarX Environment Variables

# Paper source API keys (all optional for basic functionality)
OSF_TOKEN=                    # OSF/PsyArXiv API token
S2_API_KEY=                   # Semantic Scholar API key (higher rate limits)
NCBI_API_KEY=                 # NCBI/PMC API key (higher rate limits)

# MCP Server Configuration
HOST=0.0.0.0
PORT=9600
TRANSPORT=stdio

# Tool Toggles
SEARCHTOOL=True
DISCOVERYTOOL=True
STORAGETOOL=True

# LLM Configuration (for agent mode)
PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=llama
MODEL_ID=nvidia/nemotron-3-super

# Paper Storage
SCHOLARX_STORAGE_DIR=         # Custom storage dir (default: ~/.scholarx/papers)

# Debug
DEBUG=False
PYTHONUNBUFFERED=1
