{
  "mcpServers": {
    "scholarx": {
      "command": "uv",
      "args": [
        "run",
        "scholarx-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "condensed",
        "DISCOVERYTOOL": "True",
        "NCBI_API_KEY": "your_ncbi_api_key_here",
        "OSF_TOKEN": "your_osf_token_here",
        "S2_API_KEY": "your_s2_api_key_here",
        "SEARCHTOOL": "True",
        "STORAGETOOL": "True"
      }
    }
  }
}
